formulas:
  Название: file.asLink(file.properties.title)
  Завершение: if(file.properties.completion==true,"🟩",if(file.properties.completion==false,"🟨",if(file.properties.completion==null,"🟥")))
properties:
  note.description:
    displayName: Краткое описание
  note.category:
    displayName: Категория
views:
  - type: table
    name: Таблица
    filters:
      and:
        - file.inFolder("silent_revenge_office/main_story/first_task")
    order:
      - formula.Завершение
      - formula.Название
      - category
      - description
    columnSize:
      formula.Название: 165
    rowHeight: medium
